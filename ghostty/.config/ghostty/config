# Font Configuration
font-size = 10.3

# Window Configuration
window-decoration = false
window-padding-x = 14
window-padding-y = 14
background-opacity = 0.90
font-family = GeistMono Nerd Font
#font-family = MapleMono NF CN
font-style = Regular
window-theme = ghostty
# Cursor Configuration
cursor-style = "bar"
cursor-style-blink = false

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false
#Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
config-file = ./keybinds.conf


quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

# Tab configuration
gtk-titlebar = false
gtk-toolbar-style = flat
# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# Rando stuff
gtk-single-instance = true

theme = Matugen
#custom-shader = ./shaders/cursor_trail.glsl

# Ajustes para fuentes más suaves (estilo Kitty)
font-thicken = true
freetype-load-flags = no-hinting

async-backend = epoll
mouse-scroll-multiplier = 0.95
