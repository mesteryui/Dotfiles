/**
 * Rofi Grid Launcher - Estilo GNOME
 * Solo sintaxis nativa de Rofi
 */

@import "~/.config/rofi/matugen/matugen-rofi.rasi"

* {
    font: "Inter 10";
    background-color: transparent;
    text-color: @on-surface;
}

window {
    width: 900px;
    height: 600px;
    padding: 20px;
    background-color: @surface-container;
    border: 1px;
    border-color: @outline-variant;
    border-radius: 16px;
}

mainbox {
    orientation: vertical;
    spacing: 16px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    children: [ "entry" ];
    background-color: @surface-container-high;
    border: 1px;
    border-color: @outline-variant;
    border-radius: 12px;
    padding: 12px 16px;
    margin: 0px 0px 8px 0px;
}

entry {
    placeholder: "Buscar aplicaciones...";
    placeholder-color: @on-surface-variant;
    background-color: transparent;
    text-color: @on-surface;
    expand: true;
}

listview {
    columns: 6;
    lines: 4;
    fixed-height: true;
    fixed-columns: true;
    dynamic: false;
    spacing: 12px;
    cycle: true;
    scrollbar: false;
    flow: horizontal;
}

element {
    orientation: vertical;
    spacing: 8px;
    padding: 12px 8px;
    background-color: transparent;
    text-color: @on-surface;
    border-radius: 12px;
}

element selected {
    background-color: @primary;
    text-color: @on-primary;
    border-radius: 12px;
}

element-icon {
    size: 48px;
}

element-text {
    font: "Inter 9";
    text-color: inherit;
    horizontal-align: 0.5;
}

configuration {
    modi: "drun";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "Aplicaciones";
    sidebar-mode: false;
}