@import "~/.config/rofi/matugen/matugen-rofi.rasi"

configuration {
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    disable-history: false;
    click-to-exit: true;
    location: 0;
    font: "JetBrainsMono Nerd Font 12";
}

* {
    border-radius: 12px;
}

window {
    transparency: "real";
    background-color: @surface-alpha;
    text-color: @on-surface;
    width: 95%;
    height: 85%;
    border: 3px;
    border-color: @primary;
    border-radius: 20px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 20px;
    padding: 30px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @surface-container;
    text-color: @on-surface;
    border-radius: 12px;
    padding: 15px;
    border: 1px;
    border-color: @outline-variant;
}

prompt {
    background-color: @primary-container;
    text-color: @on-primary-container;
    padding: 8px 15px;
    border-radius: 8px;
    margin: 0px 15px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @on-surface;
    placeholder-color: @on-surface-variant;
    placeholder: "Buscar juegos...";
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 3;
    lines: 2;
    cycle: true;
    dynamic: true;
    scrollbar: true;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 25px;
    padding: 20px;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-color: @primary;
    handle-width: 8px;
    padding: 0;
    margin: 0 0 0 10px;
}

element {
    background-color: @surface-container-low;
    text-color: @on-surface;
    orientation: vertical;
    border-radius: 16px;
    padding: 20px;
    border: 3px;
    border-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: @surface-container-low;
    text-color: @on-surface;
}

element normal.urgent {
    background-color: @error-container;
    text-color: @on-error-container;
}

element normal.active {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element selected.normal {
    background-color: @primary-container;
    text-color: @on-primary-container;
    border: 3px;
    border-color: @primary;
}

element selected.urgent {
    background-color: @error;
    text-color: @on-error;
    border: 2px;
    border-color: @error;
}

element selected.active {
    background-color: @secondary-container;
    text-color: @on-secondary-container;
    border: 2px;
    border-color: @secondary;
}

element-icon {
    background-color: transparent;
    size: 320px;
    border-radius: 12px;
    margin: 0px 0px 15px 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    expand: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 10px 0px 0px 0px;
}

element-text selected {
    text-color: @on-primary-container;
}

message {
    background-color: @surface-container;
    text-color: @on-surface;
    border-radius: 12px;
    border: 1px;
    border-color: @outline-variant;
    padding: 15px;
    margin: 0px 0px 15px 0px;
}

textbox {
    background-color: transparent;
    text-color: @on-surface;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

error-message {
    background-color: @error-container;
    text-color: @on-error-container;
    border-radius: 12px;
    border: 1px;
    border-color: @error;
    padding: 15px;
    margin: 0px 0px 15px 0px;
}

/* Elementos responsive */
@media ( max-width: 1400px ) {
    listview {
        columns: 2;
        lines: 2;
    }
    element-icon {
        size: 280px;
    }
}

@media ( max-width: 1000px ) {
    listview {
        columns: 2;
        lines: 3;
    }
    element-icon {
        size: 240px;
    }
}

@media ( max-width: 800px ) {
    listview {
        columns: 1;
        lines: 3;
    }
    element-icon {
        size: 200px;
    }
}