{
    "label" : "lock",
    "action" : "pidof hyprlock || hyprlock",
    "text" : "Bloquear",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Cerrar sesión",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown -t 'Apagando equipo' -p 'systemctl poweroff'",
    "text" : "Apagar",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspender",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown -t 'Reinciando equipo' -p systemctl reboot",
    "text" : "Reiniciar",
    "keybind" : "r"
}
