#!/usr/bin/env bash
set -euo pipefail

gum style \
    --foreground 212 --border-foreground 212 --border double \
    --align center --width 50 --margin "1 2" --padding "2 4" \
    "Instalacion de Steam"

sudo -v || exit 1

if ! gum confirm "¿Quieres instalar Steam?"; then
    echo "Cancelado."
    exit 0
fi

gum spin --spinner dot --title "Instalando Steam" -- sudo pacman -S --needed --noconfirm steam

echo -n "Pulse cualquier tecla para finalizar"
read -n 1 -r -s
echo
