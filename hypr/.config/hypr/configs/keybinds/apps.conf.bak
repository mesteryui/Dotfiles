# ~/.config/hypr/configs/keybinds/apps.conf

# ╔═════════════════════════════════════════════════════════════════════════════════════════════════╗
# ║                                    ATajos de aplicaciones                                       ║
# ╚═════════════════════════════════════════════════════════════════════════════════════════════════╝

# ---------------------------------------------------------------------------------------------------
# - Utilidades y herramientas del sistema
# ---------------------------------------------------------------------------------------------------
bindd = $mainMod, Return, Abrir terminal, exec, uwsm app -- $terminal
bindd = $mainMod, F, Abrir gestor de archivos, exec, uwsm app -- $fileManager
bindd = Alt, Space, Abrir menú general, exec, uwsm app -- $menu
bindd = $mainMod, Space, Abrir menú del sistema, exec, uwsm app -- $menu -s hyprsphere
bindd = Alt, K, Abrir menú de atajos de teclado, exec, uwsm app -- menubinds.sh
#bindd = $mainMod, X, Abrir menú del sistema, exec, dms ipc call settings focusOrToggle

# ---------------------------------------------------------------------------------------------------
# - Aplicaciones de productividad y comunicación
# ---------------------------------------------------------------------------------------------------
bindd = $mainMod, B, Abrir navegador, exec, uwsm app -- $browser
bindd = $mainMod, E, Ejecutar cliente Emacs, exec, uwsm app -- $emacs
bindd = SUPER, T, Abrir cliente de Telegram, exec, uwsm app -- Telegram
bindd = $mainMod, D, Abrir cliente Discord (Vesktop), exec, uwsm app -- vesktop
bindd = $mainMod, Z, Abrir cliente Whatsapp, exec, uwsm app -- zapzap

# ---------------------------------------------------------------------------------------------------
# - Utilidades y herramientas adicionales
# ---------------------------------------------------------------------------------------------------
# bindd = Alt, V, Abrir menú del portapapeles, exec, uwsm app -- $menu -m clipboard
bindd = Alt, V, Abrir menú del portapapeles, exec, $menu -m clipboard
bindd = Alt, E, Abrir menú de emojis, exec, uwsm app -- $menu -m symbols
bindd = $mainMod, G, Abrir Cartuchos, exec, uwsm app -- cartridges
