# ╔═════════════════════════════════════════════════════════════════════════════════════════════════╗
# ║                                ARCHIVO UNIFICADO DE ATAJOS (HYPRLAND)                           ║
# ╚═════════════════════════════════════════════════════════════════════════════════════════════════╝

##! Applications
###! Utilidades y herramientas del sistema
bind = SUPER, Return, exec, uwsm app -- $terminal # Abrir terminal
bind = SUPER, F, exec, uwsm app -- $fileManager # Abrir gestor de archivos
bind = ALT, Space, exec, uwsm app -- $menu # Abrir menú general
bind = SUPER, Space, exec, uwsm app -- $menu -s hyprsphere # Abrir menú del sistema
bind = ALT, K, exec, dms ipc keybinds open hyprland # Abrir menú de atajos de teclado
bind = SUPER, X, exec, dms ipc call settings focusOrToggle # Abrir menú del sistema (dms)

###! Productividad y comunicación
bind = SUPER, B, exec, uwsm app -- $browser # Abrir navegador
bind = SUPER, E, exec, uwsm app -- $emacs # Ejecutar cliente Emacs
bind = SUPER, T, exec, uwsm app -- Telegram # Abrir cliente de Telegram
bind = SUPER, D, exec, uwsm app -- vesktop # Abrir cliente Discord (Vesktop)
bind = SUPER, Z, exec, uwsm app -- zapzap # Abrir cliente Whatsapp

###! Herramientas adicionales
bind = ALT, V, exec, dms ipc clipboard toggle # Abrir menú del portapapeles
bind = ALT, E, exec, uwsm app -- $menu -m symbols # Abrir menú de emojis
bind = SUPER, G, exec, uwsm app -- cartridges # Abrir Cartuchos

##! Window Management
###! Acciones básicas
bind = SUPER Shift, Q, killactive # Cerrar aplicación activa
bind = SUPER, V, togglefloating # Alternar ventana flotante
bind = SUPER Shift, F, fullscreen # Activar o desactivar pantalla completa
bind = Alt, Tab, exec, walker -m windows # Cambiar entre ventanas
bind = SUPER, R, exec, dms restart # Reinciar DMS

###! Focus
bind = SUPER, h, movefocus, l # Cambiar foco a izquierda (Vim)
bind = SUPER, l, movefocus, r # Cambiar foco a derecha (Vim)
bind = SUPER, k, movefocus, u # Cambiar foco hacia arriba (Vim)
bind = SUPER, j, movefocus, d # Cambiar foco hacia abajo (Vim)
bind = SUPER, left, movefocus, l # Cambiar foco a izquierda
bind = SUPER, right, movefocus, r # Cambiar foco a derecha
bind = SUPER, up, movefocus, u # Cambiar foco hacia arriba
bind = SUPER, down, movefocus, d # Cambiar foco hacia abajo

###! Movimiento
bind = SUPER Shift, h, movewindow, l # Mover ventana a la izquierda (Vim)
bind = SUPER Alt, l, layoutmsg, movewindowto r # Mover ventana hyprscolling (Vim)
bind = SUPER Alt, h, layoutmsg, movewindowto l # Mover ventana hyprscrolling (Vim)
bind = SUPER Shift, l, movewindow, r # Mover ventana a la derecha (Vim)
bind = SUPER Shift, k, movewindow, u # Mover ventana hacia arriba (Vim)
bind = SUPER Shift, j, movewindow, d # Mover ventana hacia abajo (Vim)
bind = SUPER Shift, left, movewindow, l # Mover ventana a la izquierda
bind = SUPER Shift, right, movewindow, r # Mover ventana a la derecha
bind = SUPER Shift, up, movewindow, u # Mover ventana hacia arriba
bind = SUPER Shift, down, movewindow, d # Mover ventana hacia abajo

###! Layout
bind = SUPER, P, pseudo # Activar/desactivar Pseudo Tiling
bind = SUPER Alt, J, togglesplit # Cambiar tipo de división (split)

###! Resize Submap
bind = ALT, R, submap, resize # Acceder al submapa de redimensionamiento
submap = resize
  bind = , escape, submap, reset # Salir del submapa
  bind = , l, resizeactive, 10 0 # Aumentar a la izquierda (Vim)
  bind = , h, resizeactive, -10 0 # Aumentar a la derecha (Vim)
  bind = , k, resizeactive, 0 -10 # Aumentar hacia abajo (Vim)
  bind = , j, resizeactive, 0 10 # Aumentar hacia arriba (Vim)
  bind = , right, resizeactive, 10 0 # Aumentar a la izquierda
  bind = , left, resizeactive, -10 0 # Aumentar a la derecha
  bind = , up, resizeactive, 0 -10 # Aumentar hacia abajo
  bind = , down, resizeactive, 0 10 # Aumentar hacia arriba
  bind = , catchall, submap, reset # [hidden]
submap = reset

###! Grupos
bind = ALT, G, togglegroup # Alternar agrupación de ventanas
bind = SUPER ALT, G, moveoutofgroup # Mover ventana activa fuera del grupo
bind = SUPER ALT, LEFT, moveintogroup, l # Mover al grupo de la izquierda
bind = SUPER ALT, RIGHT, moveintogroup, r # Mover al grupo de la derecha
bind = SUPER ALT, UP, moveintogroup, u # Mover al grupo de arriba
bind = SUPER ALT, DOWN, moveintogroup, d # Mover al grupo de abajo
bind = SUPER ALT, TAB, changegroupactive, f # Siguiente ventana en el grupo
bind = SUPER ALT SHIFT, TAB, changegroupactive, b # Anterior ventana en el grupo
bind = SUPER ALT, LEFT, changegroupactive, b # Foco al grupo de la izquierda
bind = SUPER ALT, RIGHT, changegroupactive, f # Foco al grupo de la derecha
bind = SUPER ALT, mouse_down, changegroupactive, f # Siguiente ventana en el grupo (scroll)
bind = SUPER ALT, mouse_up, changegroupactive, b # Anterior ventana en el grupo (scroll)
bind = SUPER ALT, code:10, changegroupactive, 1 # Cambiar a ventana 1 del grupo
bind = SUPER ALT, code:11, changegroupactive, 2 # Cambiar a ventana 2 del grupo
bind = SUPER ALT, code:12, changegroupactive, 3 # Cambiar a ventana 3 del grupo
bind = SUPER ALT, code:13, changegroupactive, 4 # Cambiar a ventana 4 del grupo
bind = SUPER ALT, code:14, changegroupactive, 5 # Cambiar a ventana 5 del grupo

##! Workspaces
###! Navegación
bind = SUPER, O, exec, dms ipc hypr toggleOverview # Abrir vista de espacios de trabajo
bind = SUPER, 1, workspace, 1 # Ir al espacio de trabajo 1
bind = SUPER, 2, workspace, 2 # Ir al espacio de trabajo 2
bind = SUPER, 3, workspace, 3 # Ir al espacio de trabajo 3
bind = SUPER, 4, workspace, 4 # Ir al espacio de trabajo 4
bind = SUPER, 5, workspace, 5 # Ir al espacio de trabajo 5
bind = SUPER, 6, workspace, 6 # Ir al espacio de trabajo 6
bind = SUPER, 7, workspace, 7 # Ir al espacio de trabajo 7
bind = SUPER, 8, workspace, 8 # Ir al espacio de trabajo 8
bind = SUPER, 9, workspace, 9 # Ir al espacio de trabajo 9
bind = SUPER, 0, workspace, 10 # Ir al espacio de trabajo 10

###! Mover ventanas
bind = SUPER SHIFT, 1, movetoworkspace, 1 # Mover al espacio de trabajo 1
bind = SUPER SHIFT, 2, movetoworkspace, 2 # Mover al espacio de trabajo 2
bind = SUPER SHIFT, 3, movetoworkspace, 3 # Mover al espacio de trabajo 3
bind = SUPER SHIFT, 4, movetoworkspace, 4 # Mover al espacio de trabajo 4
bind = SUPER SHIFT, 5, movetoworkspace, 5 # Mover al espacio de trabajo 5
bind = SUPER SHIFT, 6, movetoworkspace, 6 # Mover al espacio de trabajo 6
bind = SUPER SHIFT, 7, movetoworkspace, 7 # Mover al espacio de trabajo 7
bind = SUPER SHIFT, 8, movetoworkspace, 8 # Mover al espacio de trabajo 8
bind = SUPER SHIFT, 9, movetoworkspace, 9 # Mover al espacio de trabajo 9
bind = SUPER SHIFT, 0, movetoworkspace, 10 # Mover al espacio de trabajo 10

###! Scratchpad y Relativos
bind = SUPER, S, togglespecialworkspace, magic # Abrir espacio de trabajo especial
bind = SUPER SHIFT, S, movetoworkspace, special:magic # Mover al espacio de trabajo especial
bind = SUPER Control, Right, workspace, r+1 # Cambiar al siguiente espacio de trabajo
bind = SUPER Control, Left, workspace, r-1 # Cambiar al espacio de trabajo anterior

##! System & Media
###! Audio y Brillo
bind = , XF86AudioRaiseVolume, exec, dms ipc call audio increment 10 # Subir volumen
bind = , XF86AudioLowerVolume, exec, dms ipc call audio decrement 10 # Bajar volumen
bind = , XF86AudioMute, exec, dms ipc call audio mute # Silenciar audio
bind = , XF86AudioMicMute, exec, dms ipc call audio micmute # Silenciar micrófono
bind = , XF86MonBrightnessUp, exec, dms ipc call brightness increment 10 "" # Subir brillo
bind = , XF86MonBrightnessDown, exec, dms ipc call brightness decrement 10 "" # Bajar brillo

###! Reproducción Submap
bind = SUPER, I, submap, Multimedia # Acceder al submapa multimedia
submap = Multimedia
  bind = , S, exec, dms ipc call mpris playPause # Reproducir/Pausar
  bind = , P, exec, dms ipc call mpris previous # Anterior
  bind = , N, exec, dms ipc call mpris next # Siguiente
  bind = , escape, submap, reset # Salir del submapa
submap = reset

###! Capturas de pantalla
bind = , Print, exec, screenshoter # Capturar pantalla completa
bind = SUPER, Print, exec, screenshoter selection # Capturar selección
bind = Ctrl, Print, exec, walker -m menus:screenshot # Abrir menú de capturas

###! Acciones de Sistema
bind = SUPER Shift, E, exec, dms ipc powermenu open # Abrir menú de apagado
bind = SUPER, F1, exec, bash -c "toggle-gamemode.sh" # Activar o desactivar modo de juego
bind = Alt, C, exec, swaync-client -d # Alternar modo "No molestar"
bind = SUPER, N, exec, dms ipc notifications toggle # Abrir panel de notificaciones
bind = SUPER SHIFT, N, exec, dms ipc call notepad toggle # Abrir bloc de notas
bind = SUPER, W, exec, dms ipc dankdash wallpaper # Cambiar fondo de pantalla

###! Ratón
bindm = SUPER, mouse:272, movewindow # Mover ventana con el ratón
bindm = SUPER, mouse:273, resizewindow # Redimensionar ventana con el ratón

###! Passthrough Submap
bind = SUPER, escape, submap, Passthrough # Acceder al submapa Passthrough
submap = Passthrough
  bind = , escape, submap, reset # Salir del submapa
submap = reset
