source = $HOME/.config/hypr/colors.conf
$accent = $primary
$accentAlpha = $primary
$font = JetBrainsMono Nerd Font Propo
$font_bold = JetBrainsMono Nerd Font Propo Bold

# GENERAL
general {
  disable_loading_bar = true
  hide_cursor = true
  text_trim = true
  grace = 1
}

# BACKGROUND con efecto Material You
background {
  monitor =
  path = $image
  blur_passes = 4
  color = $surface_dim
  contrast = 0.9
  brightness = 0.75
  vibrancy = 0.2
  vibrancy_darkness = 0.1
}

animations {
  enabled = true
}

# CONTENEDOR SUPERIOR - Material Surface
# shape {
#   monitor =
#   size = 100%, 400
#   color = rgba(1a111099)
#   rounding = 0
#   border_size = 0
#   position = 0, 0
#   halign = center
#   valign = top
# }

# Línea de acento superior
shape {
  monitor =
  size = 100%, 4
  color = $primary
  rounding = 0
  border_size = 0
  position = 0, 0
  halign = center
  valign = top
}

# LAYOUT PILL - Material You Style
shape {
  monitor =
  size = 180, 50
  color = $surface_container_highest
  rounding = 25
  border_size = 2
  border_color = $outline_variant
  position = 30, -30
  halign = left
  valign = top
}

label {
  monitor =
  text = 󰌌  $LAYOUT
  color = $on_surface
  font_size = 18
  font_family = $font
  position = 46, -40
  halign = left
  valign = top
}

# RELOJ - Material You con contenedor elevado
shape {
  monitor =
  size = 700, 180
  color = rgba(42373599)
  rounding = 28
  border_size = 0
  position = 0, -80
  halign = center
  valign = top
  shadow_passes = 3
  shadow_size = 5
  shadow_color = rgba(00000088)
}

label {
  monitor =
  text = $TIME
  color = $primary_fixed_dim
  shadow_boost = 0
  shadow_pass = 0
  font_size = 96
  font_family = $font_bold
  position = 0, -80
  halign = center
  valign = top
}

# FECHA - Material You subtitle style
label {
  monitor =
  text = cmd[update:30000] date +"%A, %d %B %Y"
  color = $on_surface_variant
  font_size = 22
  font_family = $font
  position = 0, -280
  halign = center
  valign = top
}

# CONTENEDOR CENTRAL - Material Surface Card
shape {
  monitor =
  size = 560, 420
  color = $surface_container_high
  rounding = 32
  border_size = 1
  border_color = $outline_variant
  position = 0, 0
  halign = center
  valign = center
  shadow_passes = 4
  shadow_size = 8
  shadow_color = rgba(00000066)
}

# USER AVATAR con borde Material You
image {
  monitor =
  path = $HOME/.face
  size = 140
  border_size = 4
  border_color = $primary
  rounding = -1
  position = 0, 110
  halign = center
  valign = center
  shadow_passes = 3
  shadow_size = 6
  shadow_color = rgba(00000055)
}

# USERNAME LABEL
label {
  monitor =
  text = $USER
  color = $on_surface
  font_size = 26
  font_family = $font_bold
  position = 0, -38
  halign = center
  valign = center
}

# INPUT FIELD - Material You Style
input-field {
  monitor =
  size = 480, 70
  outline_thickness = 2
  dots_size = 0.25
  dots_spacing = 0.3
  dots_center = true
  outer_color = $primary_container
  inner_color = $surface_container_highest
  font_color = $on_surface
  fade_on_empty = false
  placeholder_text = <span foreground="##d8c2be"><i>🔒 Ingrese contraseña</i></span>
  hide_input = false
  check_color = $primary
  fail_color = $error
  fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>
  capslock_color = $tertiary
  rounding = 20
  position = 0, -140
  halign = center
a  valign = center
  shadow_passes = 2
  shadow_size = 4
}

# BATTERY INFO CARD - Material You
shape {
  monitor =
  size = 140, 60
  color = $surface_container
  rounding = 24
  border_size = 1
  border_color = $outline_variant
  position = -30, -30
  halign = right
  valign = top
}

label {
  monitor =
  text = cmd[update:1000] echo -e "$(~/.config/hypr/scripts/battery-infolock.sh)"
  color = $on_surface
  font_size = 20
  font_family = $font
  position = -45, -42
  halign = right
  valign = top
}

# BOTTOM ACCENT LINE
shape {
  monitor =
  size = 100%, 3
  color = $primary_container
  rounding = 0
  border_size = 0
  position = 0, 0
  halign = center
  valign = bottom
}

# HINT TEXT - Material You caption
label {
  monitor =
  text = Presiona Enter para desbloquear
  color = $outline
  font_size = 14
  font_family = $font
  position = 0, 60
  halign = center
  valign = bottom
}
