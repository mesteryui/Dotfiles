{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/anime-girl-mip.png",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "keys": "cyan",
      "separator": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "cyan"
    },
    {
      "type": "wmtheme",
      "key": "󰉋 Theme",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "terminalfont",
      "key": " Font",
      "keyColor": "cyan"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "green",
      "format": "{1} ({3}) @ {7} GHz"
    },
    {
      "type": "gpu",
      "key": "󰟮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "green"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "localip",
      "key": "󰈀 Local IP",
      "keyColor": "yellow",
      "format": "{ipv4}"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery",
      "keyColor": "yellow"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "key": "󰸌 colors",
      "type": "colors",
      "symbol": "circle",
      "keyColor": "white"
    }
  ]
}
