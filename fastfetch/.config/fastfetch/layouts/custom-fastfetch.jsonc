{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/assets/pngwingScaled.com.png",
    "padding": {
      "right": 0,
      "top": 0
    }
  },
  "display": {
    "separator": "󰁔 "
  },
  "modules": [
    {
      "type": "title",
      "format": " {6}{7}{8}"
    },
    {
      "type": "custom",
      "format": " ─────────────"
    },
    {
      "type": "os",
      "keyColor": "blue",
      "key": " 󰣇 "
    },
    {
      "type": "kernel",
      "keyColor": "yellow",
      "key": "  "
    },
    {
      "type": "packages",
      "keyColor": "green",
      "key": " 󰏖 "
    },
    {
      "type": "shell",
      "keyColor": "cyan",
      "key": " 󰆍 "
    },
    {
      "type": "wm",
      "keyColor": "magenta",
      "key": " 󰨇 "
    },
    {
      "type": "terminal",
      "keyColor": "blue",
      "key": " 󰆍 "
    },
    {
      "type": "cpu",
      "keyColor": "red",
      "key": " 󰻠 "
    },
    {
      "type": "gpu",
      "keyColor": "yellow",
      "key": " 󰍛 "
    },
    {
      "type": "disk",
      "keyColor": "cyan",
      "key": " 󰋊 "
    },
    {
      "type": "uptime",
      "keyColor": "green",
      "key": " 󰅐 "
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
