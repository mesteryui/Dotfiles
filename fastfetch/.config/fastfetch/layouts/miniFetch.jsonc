{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/assets/pngwingScaled.com.png",
    "padding": {
      "left": 0,
      "top": 0,
      "right": 4
    },
    "width": 40,
    "height": 32
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#EBDBB2",
      "title": "#FABD2F",
      "output": "#FBF1C7",
      "separator": "#928374"
    }
  },
  "modules": [
    {
      "key": "│ {#34}{icon} distro  {#keys}│",
      "type": "os"
    },
    {
      "key": "│ {#35} kernel  {#keys}│",
      "type": "kernel"
    },
    {
      "key": "│ {#33}󰅐 uptime  {#keys}│",
      "type": "uptime"
    },
    "packages",
    {
      "key": "│ {#32} shell   {#keys}│",
      "type": "shell"
    },
    {
      "key": "│ {#36}󰇄 desktop {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#36} wm      {#keys}│",
      "type": "wm"
    },
    "theme",
    {
      "key": "│ {#31} term    {#keys}│",
      "type": "terminal"
    },
    {
      "key": "│ {#33}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ {#36} memory  {#keys}│",
      "type": "memory"
    },
    {
      "key": "│ {#34}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/"
    }
  ]
}
