[General]
description=Refined Kvantum theme using Matugen colors
translucent=false

[Colors]
window.color=$surface
base.color=$background
button.color=$surfaceVariant
highlight.color=$primary
selection.background=$primaryContainer
selection.foreground=$onPrimaryContainer
text.color=$onSurface
window.text.color=$onSurface
button.text.color=$onSurfaceVariant
highlighted.text.color=$onPrimary
tooltip.background=$surface
tooltip.text=$onSurface
link.color=$primary
visited.link.color=$primary

[Window]
border.width=1
border.color=$outlineVariant
titlebar.active.bg=$primary
titlebar.active.fg=$onPrimary
titlebar.inactive.bg=$surfaceVariant
titlebar.inactive.fg=$onSurfaceVariant

[Buttons]
default.button.color=$primary
default.button.text.color=$onPrimary
button.hover.color=$primaryContainer
button.hover.text.color=$onPrimaryContainer
button.pressed.color=$primary
button.pressed.text.color=$onPrimary
button.disabled.color=$surfaceVariant
button.disabled.text.color=$onSurfaceVariant

[Scrollbars]
handle.color=$primaryContainer
handle.hover.color=$primary
bgnd.color=$surface

[Tabs]
tab.active.bg=$primaryContainer
tab.active.fg=$onPrimaryContainer
tab.inactive.bg=$surface
tab.inactive.fg=$onSurfaceVariant

[Menu]
menu.bg=$surface
menu.fg=$onSurface
menu.highlight.bg=$primaryContainer
menu.highlight.fg=$onPrimaryContainer

[ToolTip]
tooltip.bg=$surfaceVariant
tooltip.fg=$onSurface
