        "scrollbarSlider.activeBackground": "{{colors.outline.default.hex}}80",
        "badge.background": "{{colors.secondary.default.hex}}",
        "badge.foreground": "{{colors.on_secondary.default.hex}}",
        "peekView.border": "{{colors.outline.default.hex}}",
        "peekViewTitle.background": "{{colors.surface_bright.default.hex}}",
        "peekViewTitleLabel.foreground": "{{colors.on_surface.default.hex}}",
        "peekViewTitleDescription.foreground": "{{colors.on_surface.default.hex}}60",
        "peekViewEditor.background": "{{colors.surface.default.hex}}",
        "peekViewResult.background": "{{colors.surface_dim.default.hex}}",
