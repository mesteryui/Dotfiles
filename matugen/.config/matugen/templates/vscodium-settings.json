        "notifications.foreground": "{{colors.on_surface.default.hex}}",
        "notificationLink.foreground": "{{colors.primary.default.hex}}",
        "notificationCenterHeader.foreground": "{{colors.on_surface.default.hex}}",
        "notificationCenterHeader.background": "{{colors.surface.default.hex}}",
        "notificationToast.border": "{{colors.outline_variant.default.hex}}"
