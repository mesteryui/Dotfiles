{
  "material-code.colors": {
    "primary": "{{colors.primary.default.hex}}",
    "foreground": "{{colors.on_surface.default.hex}}",
    "mutedForeground": "{{colors.on_surface_variant.default.hex}}",
    "background": "{{colors.surface.default.hex}}",
    "card": "{{colors.surface_container.default.hex}}",
    "popover": "{{colors.surface_container_high.default.hex}}",
    "hover": "{{colors.surface_container_highest.default.hex}}",
    "border": "{{colors.outline_variant.default.hex}}",
    "primaryForeground": "{{colors.on_primary.default.hex}}",
    "secondary": "{{colors.secondary_container.default.hex}}",
    "secondaryForeground": "{{colors.on_secondary_container.default.hex}}",
    "error": "{{colors.error.default.hex}}",
    "errorForeground": "{{colors.on_error.default.hex}}",
    "success": "",
    "warning": "",
    "syntax.comment": "",
    "syntax.string": "{{colors.secondary.default.hex}}",
    "syntax.keyword": "{{colors.primary.default.hex}}",
    "syntax.variable": "",
    "syntax.attribute": "{{colors.secondary.default.hex}}",
    "syntax.property": "{{colors.primary.default.hex}}",
    "syntax.function": "",
    "syntax.constant": "{{colors.primary.default.hex}}",
    "syntax.bracket1": "",
    "syntax.bracket2": "",
    "syntax.bracket3": "",
    "syntax.bracket4": ""
  },
  "editor.fontFamily": "'Maple Mono NF CN','Droid Sans Mono', 'monospace', monospace",
  "window.menuBarVisibility": "hidden",
  "editor.semanticHighlighting.enabled": true,
  "window.menuStyle": "native",
  "workbench.colorTheme": "Material Code",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.iconTheme": "material-icon-theme",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "workbench.statusBar.visible": false,
  "workbench.activityBar.location": "default",
  "editor.padding.bottom": 15,
  "editor.padding.top": 15,
  "window.customTitleBarVisibility": "never",
  "window.titleBarStyle": "native",
  "breadcrumbs.enabled": false
}
